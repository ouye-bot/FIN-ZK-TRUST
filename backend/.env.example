# ============================================
# FinZkTrust 系统环境变量配置示例
# 复制此文件为 .env 并填入实际值
# cp .env.example .env
# ============================================

# ============================================
# SM4 主密钥配置（必填）
# ============================================
# SM4 对称加密密钥，用于加密敏感业务数据（余额、积分等）
# 格式：32位十六进制字符串（128位密钥）
# 生成命令：node -e "console.log(require('crypto').randomBytes(16).toString('hex'))"
SM4_MASTER_KEY=<your-32-hex-chars-sm4-key>

# ============================================
# 区块链配置 - Hardhat 本地私链
# ============================================

# Hardhat 本地私链 RPC 地址
BLOCKCHAIN_RPC_URL=http://127.0.0.1:8545

# Hardhat 本地私链 Chain ID (31337 是 Hardhat 默认私链ID)
BLOCKCHAIN_CHAIN_ID=31337

# Hardhat 默认私钥（账户0）- 用于自动签名上链
# 注意：这是 Hardhat 本地私链的默认测试私钥，仅用于开发和竞赛演示
HARDHAT_PRIVATE_KEY=0xac0974bec39a17e36ba4a6b4d238ff944bacb478cbed5efcae784d7bf4f2ff80

# 智能合约地址（部署后自动填充）
CONTRACT_ADDRESS=

# ============================================
# 服务器配置
# ============================================

# 服务器端口（默认 3003）
PORT=3003

# JWT 签名密钥（必填，至少32个字符）
JWT_SECRET=<your-jwt-secret-min-32-chars>

# Session 密钥（必填，至少32个字符）
SESSION_SECRET=<your-session-secret-min-32-chars>

# ============================================
# 数据库配置 - MySQL
# ============================================

# 数据库主机（默认 localhost）
DB_HOST=localhost

# 数据库端口（默认 3306）
DB_PORT=3306

# 数据库用户名
DB_USER=root

# 数据库密码
DB_PASSWORD=123456

# 数据库名称（默认 finzktrust）
DB_NAME=finzktrust

# ============================================
# 日志配置
# ============================================

# 日志级别: debug, info, warn, error
LOG_LEVEL=info

# ============================================
# 功能开关
# ============================================

# 是否启用区块链存证功能
ENABLE_BLOCKCHAIN=true

# 是否自动部署合约（开发环境）
AUTO_DEPLOY_CONTRACT=false
